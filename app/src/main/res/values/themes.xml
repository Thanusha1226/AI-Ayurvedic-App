<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base HerbalEyes Theme -->
    <style name="Base.Theme.AIProject" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryDark">@color/green_dark</item>
        <item name="colorAccent">@color/green_light</item>
        <item name="android:statusBarColor">@color/green_dark</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.AIProject" parent="Base.Theme.AIProject" />

    <!-- Splash Screen Theme -->
    <style name="Theme.AIProject.Splash" parent="Theme.AIProject">
        <item name="android:statusBarColor">@color/green_dark</item>
        <item name="android:windowBackground">@color/green_dark</item>
    </style>

    <!-- Button Styles -->
    <style name="HerbalButton" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/green_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="HerbalButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/green_primary</item>
        <item name="android:textColor">@color/green_primary</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Card Style -->
    <style name="HerbalCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
    </style>

    <!-- EditText Style -->
    <style name="HerbalEditText" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/green_primary</item>
        <item name="hintTextColor">@color/green_primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Toolbar -->
    <style name="HerbalToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/green_primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/green_pale</item>
    </style>
</resources>